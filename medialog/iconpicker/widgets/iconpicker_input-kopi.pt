<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:tal="http://xml.zope.org/namespaces/tal"
    xmlns:metal="http://xml.zope.org/namespaces/metal">

    <!-- Codethereal Iconpicker -->
    <script src="https://unpkg.com/codethereal-iconpicker@1.2.1/dist/iconpicker.js"></script>
    <tal:resources tal:replace="structure view/fonticonset"/>

    <div>
        <input tal:attributes="id string:${view/id};
                       name view/name;
                       title view/title;
                       lang view/lang;
                       alt view/alt;
                       accesskey view/accesskey;
                       onselect view/onselect;
                       size view/size;
                       maxlength view/maxlength" />
    </div>


    <script type="text/javascript">
jQuery(function($) {
    var $button = $("#${view/id}");
    var $input = $("#${view/id}");

    var faIcons = [
        "fa fa-star", "fa fa-heart", "fa fa-moon-o", "fa fa-sun-o",
        "fa fa-bell", "fa fa-bolt", "fa fa-camera", "fa fa-car",
        "fa fa-cloud", "fa fa-cog", "fa fa-comments", "fa fa-envelope",
        "fa fa-home", "fa fa-info", "fa fa-lock", "fa fa-map",
        "fa fa-phone", "fa fa-print", "fa fa-search", "fa fa-user"
    ];

    // Initialize Iconpicker
    var iconpicker = new Iconpicker($button[0], {
        icons: faIcons,
        hideOnSelect: true,
        defaultValue: $input.val(),
        renderIcon: function(iconClass) {
            return 'iconClass';
        }
    });

    // Toggle visibility/opacity on click
    $button.on("click", function() {
        var $dropdown = $(".iconpicker-dropdown"); // the dropdown element
        $dropdown.show();
    });

 
});
    </script>

    <style>
    .iconpicker-btn {
      display: inline-flex;
      align-items: center;
      padding: 0.5rem 0.75rem;
      border: 1px solid #ccc;
      border-radius: 0.25rem;
      background: #f8f9fa;
      cursor: pointer;
      font-size: 1rem;
      gap: 0.5rem;
    }
    .iconpicker-dropdown { position: relative; left: 0; z-index: 1050}

    .iconpicker-btn:hover {
      background: #e9ecef;
    }
    .iconpicker-btn i {
      font-size: 1.2rem;
    }
    </style>



</html>
