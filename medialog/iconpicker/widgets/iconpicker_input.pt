<html>

    <!-- Codethereal Iconpicker -->
    <head>
        <script src="https://unpkg.com/codethereal-iconpicker@1.2.1/dist/iconpicker.js"></script>
        <tal:resources tal:replace="structure view/fonticonset"/>
    </head>
    <body>
    <span class="ontop">

        <input tal:attributes="id string:${view/id};
                       class view/family_css;
                       name view/name;
                       title view/title;
                       lang view/lang;
                       alt view/alt;
                       value view/value;
                       accesskey view/accesskey;
                       onselect view/onselect;
                       size view/size;
                       maxlength view/maxlength" />
    </span>

    <script type="text/javascript">
    jQuery(function($) {
        var $button = $("#${view/id}");
        var $input = $("#${view/id}");

        var iconset = $.iconset || {};
        var ikons = [];
        

        if (iconset.icons && iconset.icons.length) {
        var base = iconset.iconClass || "";
        var fix  = iconset.iconClassFix || "";
        for (var i=0; i<iconset.icons.length; i++) {
            var name = iconset.icons[i];
            if (!name) continue;
            // build something like "fa fa-address-book"
            ikons.push(base + " " + fix + name);
        }
    }
 


    // Initialize Iconpicker
    var iconpicker = new Iconpicker($button[0], {
        icons: ikons,
        hideOnSelect: true,
        fade: false,
        defaultValue: $input.val(),
        renderIcon: function(iconClass) {
            return iconClass;
        }
    });

    // Toggle visibility/opacity on click
    $button.on("click", function() {
        var $dropdown = $(".iconpicker-dropdown"); // the dropdown element
        $dropdown.show();
    }); 
});
    </script>

<style>
    .iconpicker-btn {
      display: inline-flex;
      align-items: center;
      padding: 0.5rem 0.75rem;
      border: 1px solid #ccc;
      border-radius: 0.25rem;
      background: #f8f9fa;
      cursor: pointer;
      font-size: 1rem;
      gap: 0.5rem;
    }
    .iconpicker-dropdown { position: relative; left: 0; z-index: 1050}
    .iconpicker-dropdown ul { width: ${view/cols}px ; height: ${view/rows}px ; }

    </style>
    </body>
</html>

 