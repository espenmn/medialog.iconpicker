<html>

<span class="ontop">
<button  class="btn btn-standalone btn-primary success"
 			role="iconpicker"
			tal:attributes="id string:${view/id};
                       name view/name;
                       data-iconset   view/iconset;
                       data-icon      view/value;
                       data-rows      view/rows;
                       data-cols      view/cols;
                       data-placement view/placement;
                       value view/value;
                       disabled view/disabled;
                       alt view/alt;
                       accesskey view/accesskey;
                       onselect view/onselect;"  />


<input  type="hidden"  disabled="True" tal:attributes="id string:${view/id};
                       name view/name;
                       title view/title;
                       lang view/lang;
                       alt view/alt;
                       accesskey view/accesskey;
                       onselect view/onselect;
                       size view/size;
                       maxlength view/maxlength" />

<tal:resources tal:replace="structure view/fonticonset"/>

<link rel="stylesheet" href="++resource++medialog.iconpicker/bootstrap-iconpicker/css/bootstrap-iconpicker.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js"></script>
<script type="text/javascript" src="++resource++medialog.iconpicker/bootstrap-iconpicker/js/bootstrap-iconpicker-mn.js"></script>

 
</span>

</html>
